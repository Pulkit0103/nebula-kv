# Normalize all text files to LF in the repository
* text=auto eol=lf

# Java source
*.java text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.properties text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.sh text eol=lf

# Binaries — never mangle
*.jar binary
*.class binary
*.png binary
*.jpg binary
